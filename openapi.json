  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dq_session"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "water_goal_ml": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "timezone",
          "water_goal_ml"
        ]
      },
      "Water": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_ml": {
            "type": "integer"
          },
          "consumed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "amount_ml",
          "consumed_at"
        ]
      },
      "WaterInput": {
        "type": "object",
        "properties": {
          "amount_ml": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "consumed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "amount_ml",
          "consumed_at"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "water_goal_ml": {
            "type": "integer",
            "minimum": 100,
            "maximum": 20000
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "water_goal_ml",
          "timezone"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
